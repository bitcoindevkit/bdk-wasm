{
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "build": "wasm-pack build --target nodejs --all-features --locked",
    "build:debug": "wasm-pack build --dev --target nodejs --all-features --locked",
    "test": "vitest run --exclude \"integration/{esplora,events,policy_regtest}.test.ts\" --exclude \"smoke/**\"",
    "clean": "rm -rf node_modules pkg dist build coverage .cache *.log",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run integration/esplora.test.ts integration/events.test.ts integration/policy_regtest.test.ts smoke/esplora.test.ts",
    "test:signet": "NETWORK=signet vitest run smoke/esplora.test.ts",
    "test:coverage": "yarn test --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "bip39": "^3.1.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
